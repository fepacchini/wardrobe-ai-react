# ────────────────────────────────────────
# Claude AI (Anthropic) — Estilista IA Chat
# Get your key at https://console.anthropic.com
# ────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: change the API server port (default: 3001)
# API_PORT=3001

# ────────────────────────────────────────
# Supabase Configuration
# Copy this file to .env and fill in your Supabase project credentials.
# Create a free project at https://supabase.com

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ------------------------------------------------------------
# Supabase Setup Instructions:
# 1. Create a project at https://supabase.com
# 2. Go to Settings > API to find your URL and anon key
# 3. Run the SQL below in your Supabase SQL Editor
# 4. Create a storage bucket named "wardrobe-images" (public)
# ------------------------------------------------------------
#
# SQL to create the wardrobe_items table:
#
# CREATE TABLE wardrobe_items (
#   id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
#   title TEXT DEFAULT '',
#   category TEXT NOT NULL DEFAULT 'top',
#   style TEXT NOT NULL DEFAULT 'casual',
#   fabric TEXT NOT NULL DEFAULT 'unknown',
#   colors JSONB DEFAULT '[]',
#   tags TEXT[] DEFAULT '{}',
#   favorite BOOLEAN DEFAULT false,
#   image_url TEXT DEFAULT '',
#   created_at TIMESTAMPTZ DEFAULT NOW(),
#   updated_at TIMESTAMPTZ DEFAULT NOW()
# );
#
# Enable Row Level Security (RLS) - optional but recommended:
# ALTER TABLE wardrobe_items ENABLE ROW LEVEL SECURITY;
# CREATE POLICY "Public access" ON wardrobe_items FOR ALL USING (true);
#
# Create storage bucket:
# 1. Go to Storage in the Supabase dashboard
# 2. Create a new bucket named "wardrobe-images"
# 3. Make it public (for read access without auth)
